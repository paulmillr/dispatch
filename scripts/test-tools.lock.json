          ],
          [
            "make",
            "-j{jobs}"
          ],
          [
            "make",
            "install"
          ]
        ]
      },
      {
        "directory": "tmux-3.8",
        "commands": [
          [
            "./configure",
            "--prefix={stage}/install",
            "--disable-utf8proc",
            "LIBEVENT_CFLAGS=-I{stage}/deps/include",
            "LIBEVENT_LIBS={stage}/deps/lib/libevent.a"
          ],
          [
            "make",
            "-j{jobs}"
          ]
        ]
