<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The complications' entry (docs/watch.md, Complications): the app writes it, the widget extension reads it. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(DISPATCH_APP_GROUP)</string>
	</array>
</dict>
</plist>
