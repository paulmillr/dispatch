+
+/// Dispatch: a direct public key request (`Handle::next_publickey_direct`). Its signed
+/// `USERAUTH_REQUEST` goes without the query (`PK_OK` is never waited for) and, as the
+/// connection's first request, right behind `SERVICE_REQUEST` without waiting for the accept,
+/// which (with any `EXT_INFO`) then arrives while the request is pending.
+#[derive(Debug, Default)]
+pub(crate) enum Direct {
+    #[default]
+    Off,
+    /// The next public key `Authenticate` goes direct.
+    Next,
+    /// The external signer has the bytes to sign (`Reply::SignRequest`, raised as the request is
+    /// written, since they hold the session id): `Msg::Signed` writes the request from `offset`,
+    /// `Msg::SignFailed` drops it unwritten, so the next request starts over.
+    Signing {
+        offset: usize,
+        length: usize,
+        request: AuthRequest,
+    },
+    /// Written before the server accepted the userauth service: its accept moves on to waiting
+    /// for the answer.
+    Written(AuthRequest),
+}
+
+impl Direct {
+    /// The userauth service was accepted: a request written before waits for its answer now.
+    pub(crate) fn accepted(&mut self) -> Option<AuthRequest> {
+        match std::mem::take(self) {
+            Direct::Written(request) => Some(request),
+            other => {
+                *self = other;
+                None
+            }
+        }
+    }
+}
+
+impl Session {
+    /// Dispatch: writes `method` as a direct request when `Msg::DirectPublicKey` asked for one and
+    /// it is a public key; anything else comes back for `write_auth_request_if_needed`.
+    pub(crate) fn write_direct_auth_request(
+        &mut self,
+        user: &str,
+        method: auth::Method,
+    ) -> Result<Option<auth::Method>, crate::Error> {
+        let next = matches!(self.direct, Direct::Next);
+        if next {
+            self.direct = Direct::Off;
+        }
+        let public_key = matches!(
+            method,
+            auth::Method::PublicKey { .. } | auth::Method::FuturePublicKey { .. }
+        );
+        let Some(enc) = self.common.encrypted.as_mut().filter(|_| next && public_key) else {
+            return Ok(Some(method));
+        };
+        let accepted = match enc.state {
+            EncryptedState::WaitingAuthServiceRequest {
+                accepted,
+                ref mut sent,
+            } => {
+                if !*sent {
+                    self.common.packet_writer.write_packet(|w| {
+                        msg::SERVICE_REQUEST.encode(w)?;
+                        "ssh-userauth".encode(w)?;
+                        Ok(())
+                    })?;
+                    *sent = true
+                }
+                accepted
+            }
+            EncryptedState::WaitingAuthRequest(_) => true,
+            EncryptedState::InitCompression | EncryptedState::Authenticated => {
+                return Ok(Some(method));
+            }
+        };
+        debug!("direct public key request, service accepted: {accepted:?}");
+        self.common.auth_user.clear();
+        self.common.auth_user.push_str(user);
+        // Nothing is left to send for it: an accept or a PK_OK arriving meanwhile writes nothing.
+        self.common.auth_method = None;
+        let request = AuthRequest::new(&method);
+        match &method {
+            auth::Method::FuturePublicKey { key, hash_alg } => {
+                let mut data = Vec::new();
+                let offset = enc.client_make_to_sign(
+                    user,
+                    &PublicKeyOrCertificate::PublicKey {
+                        key: key.clone(),
+                        hash_alg: *hash_alg,
+                    },
+                    None,
+                    &mut data,
+                )?;
+                let length = data.len();
+                self.sender
+                    .send(Reply::SignRequest {
+                        key: key.clone(),
+                        data,
+                    })
+                    .map_err(|_| crate::Error::SendError)?;
+                self.direct = Direct::Signing {
+                    offset,
+                    length,
+                    request,
+                };
+            }
+            _ => {
+                self.common.buffer.clear();
+                enc.client_send_signature(user, &method, &mut self.common.buffer)?;
+                if accepted {
+                    enc.state = EncryptedState::WaitingAuthRequest(request);
+                } else {
+                    self.direct = Direct::Written(request);
+                }
+            }
+        }
+        Ok(None)
+    }
+
+    /// Dispatch: the external signer's answer to a direct request (`Direct::Signing`); `None`
+    /// when it declined. Ignored otherwise, as before.
+    pub(crate) fn direct_signed(&mut self, data: Option<Vec<u8>>) -> Result<(), crate::Error> {
+        if !matches!(self.direct, Direct::Signing { .. }) {
+            return Ok(());
+        }
+        let Direct::Signing {
+            offset,
+            length,
+            request,
+        } = std::mem::take(&mut self.direct)
+        else {
+            return Ok(());
+        };
+        let Some(data) = data else {
+            debug!("signer failed, the direct request is not written");
+            return Ok(());
+        };
+        let Some(enc) = self.common.encrypted.as_mut() else {
+            return Ok(());
+        };
+        let accepted = match enc.state {
+            EncryptedState::WaitingAuthServiceRequest { accepted, .. } => accepted,
+            EncryptedState::WaitingAuthRequest(_) => true,
+            EncryptedState::InitCompression | EncryptedState::Authenticated => return Ok(()),
+        };
+        // The signer appends the signature to the bytes it was given; anything else would leave
+        // the caller waiting for an answer that never comes.
+        let Some(signed) = data.get(offset..).filter(|_| data.len() > length) else {
+            return Err(crate::Error::Inconsistent);
+        };
+        push_packet!(enc.write, {
+            enc.write.extend_from_slice(signed);
+        });
+        if accepted {
+            enc.state = EncryptedState::WaitingAuthRequest(request);
+        } else {
+            self.direct = Direct::Written(request);
+        }
+        Ok(())
+    }
+}
