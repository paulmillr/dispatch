    "output": "1\t\"use client\";\n2\timport { createContext, useContext, useEffect, useState } from \"react\";\n3\t\n4\texport type Theme = \"system\" | \"light\" | \"dark\";\n5\tconst ThemeContext = createContext<{ theme: Theme; setTheme: (t: Theme) => void } | null>(null);\n6\t\n7\texport function ThemeProvider({ initial, children }: { initial: Theme; children: React.ReactNode }) {\n8\t  const [theme, setTheme] = useState<Theme>(initial);\n9\t  useEffect(() => {\n10\t    const dark = theme === \"dark\" || (theme === \"system\" && matchMedia(\"(prefers-color-scheme: dark)\").matches);\n11\t    document.documentElement.classList.toggle(\"dark\", dark);\n12\t  }, [theme]);\n13\t  return <ThemeContext.Provider value={{ theme, setTheme }}>{children}</ThemeContext.Provider>;\n14\t}\n15\t\n16\texport function useTheme() {\n17\t  const value = useContext(ThemeContext);\n18\t  if (!value) throw new Error(\"useTheme outside ThemeProvider\");\n19\t  return value;\n20\t}\n",
